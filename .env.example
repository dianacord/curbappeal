# All optional — CurbAppeal runs in demo mode with none of these set.

# Anthropic API key → enables "api" AI mode (best quality control, structured outputs).
# Without it, CurbAppeal drives your local `claude` CLI (Claude Code login) instead.
# ANTHROPIC_API_KEY=sk-ant-...

# Google Places API (New) key → enables researching ANY real business.
# Free tier is generous (thousands of lookups/month). Setup: see README "Going live".
# GOOGLE_PLACES_API_KEY=AIza...

# Force modes (normally auto-detected): api | cli | mock, live | fixture
# CURBAPPEAL_LLM_MODE=cli
# CURBAPPEAL_PLACES_MODE=fixture

# PORT=4747
